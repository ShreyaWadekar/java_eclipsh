package ThreadDemo;

class table
{
	public void printTable(int num)
	{
		for(int i=1;i<=5;i++)
		{
			System.out.println(num*i);
			
		   try {
			   Thread.sleep(500);
		} catch (Exception e) {
			System.out.println(e);
		}
		}
	}
}

class MyThread1 extends Thread
{
	table t;
	public void MyThread1(table t)
	{
		this.t=t;
	}
	public void run()
	{
		t.printTable(5);
	}
}

