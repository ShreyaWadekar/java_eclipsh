package ThreadDemo;

class PrintDetails
{
	public void printMassage(String s) 
	{
		for(int i=1;i<=5;i++)
		{
			System.out.println("Good Luck...");
			System.out.println(s);
			
			try {
				   Thread.sleep(1000);
			} catch (Exception e) {
				System.out.println(e);
			}
		}
	}
}

class Mythread extends Thread
{
	PrintDetails d;
	String s;
	
	public Mythread(PrintDetails d,String s)
	{
		this.d=d;
		this.s=s;
	}
	public void run()
	{
		d.printMassage(s);
	}
}
public class TestStaticSynchronized {

	public static void main(String[] args) {
		PrintDetails obj1= new PrintDetails();
		
		PrintDetails obj2= new PrintDetails();
		
		Mythread t1= new Mythread(obj1, "Shreya");
		
		Mythread t2= new Mythread(obj2, "Aniket");
		
		t1.start();
		t2.start();
	}

}
