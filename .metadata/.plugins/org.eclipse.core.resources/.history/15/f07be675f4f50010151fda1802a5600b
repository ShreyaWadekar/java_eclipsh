package FileHandling;

import java.io.ByteArrayOutputStream;
import java.io.FileOutputStream;

public class ByteArrayOutputStreamDemo {

	public static void main(String[] args) {
		try {
			FileOutputStream fout1= new FileOutputStream("C:\\File Date\\test1.txt");
			FileOutputStream fout2= new FileOutputStream("C:\\File Date\\test2.txt");
			FileOutputStream fout3= new FileOutputStream("C:\\File Date\\test3.txt");
			
			ByteArrayOutputStream bout = new ByteArrayOutputStream();
			
			bout.write(65);
			
			bout.writeTo(fout1);
			bout.writeTo(fout2);
			bout.writeTo(fout3);
			
			bout.flush();
			bout.close();
		}
		catch (Exception e) 
		{
			System.out.println(e);
		}

	}

}
